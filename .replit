modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
APP_BASE_URL = "https://plainpathapp.com/app"
VITE_BUILDER_ENABLED = "true"
BUILDER_ENABLED = "true"
ADMIN_EMAILS = "support@plainpathapp.com"
ALLOWED_EMAILS = "support@plainpathapp.com,yelevels@gmail.com"
ACCESS_MODE = "internal_only"
MANUAL_PRO_EMAILS = "yelevels@gmail.com,reviewer@plainpathapp.com"
VITE_ANALYZE_COMPLETION_FLOW_ENABLED = "true"

[nix]
channel = "stable-25_05"
