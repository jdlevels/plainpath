{"version":8,"type":"context-options","origin":"library","browserName":"chromium","playwrightVersion":"1.59.1","options":{"noDefaultViewport":false,"viewport":{"width":1280,"height":720},"ignoreHTTPSErrors":false,"javaScriptEnabled":true,"bypassCSP":false,"userAgent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.7727.15 Safari/537.36","locale":"en-US","offline":false,"deviceScaleFactor":1,"isMobile":false,"hasTouch":false,"colorScheme":"light","acceptDownloads":"accept","baseURL":"http://localhost:80","serviceWorkers":"allow","selectorEngines":[],"testIdAttributeName":"data-testid"},"platform":"linux","wallTime":1778258903565,"monotonicTime":85685.744,"sdkLanguage":"javascript","testIdAttributeName":"data-testid","contextId":"browser-context@7fb7023ccbbd1e54d91074a85616370d","title":"actionable-button-audit.spec.ts:520 › Hidden tool route enforcement › /app/builder redirects away from hidden tool"}
