modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
APP_BASE_URL = "https://plain-path.replit.app/app"
VITE_BUILDER_ENABLED = "true"
BUILDER_ENABLED = "true"
ADMIN_EMAILS = "support@plainpathapp.com,pdfverify@example.com"

[nix]
channel = "stable-25_05"
